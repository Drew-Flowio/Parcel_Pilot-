# =============================================================================
# Parcel Pilot — environment variables
# =============================================================================
# Copy to .env.local for local development, OR set on Vercel via
#   vercel env add <NAME> production
#   vercel env add <NAME> preview
#
# Use `GET /api/admin/preflight` to validate that everything is wired up.
# =============================================================================

# ----- Supabase (required) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional public key (for any client-side reads — currently unused, server-only)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ----- Skywalk inbound ingestion (required for sync to function) -------------
SKYWALK_BASE_URL=
SKYWALK_API_KEY=
SKYWALK_SYNC_SECRET=

# Optional Skywalk tuning (sane defaults — only set to override)
# SKYWALK_AUTH_HEADER=Authorization
# SKYWALK_AUTH_SCHEME=Bearer\ 
# SKYWALK_TIMEOUT_MS=15000
# SKYWALK_MAX_RETRIES=4
# SKYWALK_USER_AGENT=parcel-pilot-skywalk/1.0
# SKYWALK_MESSAGES_PATH=/v1/messages
# SKYWALK_CONTACTS_PATH=/v1/contacts
# SKYWALK_PROPERTIES_PATH=/v1/properties
# SKYWALK_MESSAGE_BY_ID=/v1/messages/{id}
# SKYWALK_CONTACT_BY_ID=/v1/contacts/{id}
# SKYWALK_PROPERTY_BY_ID=/v1/properties/{id}

# ----- Skywalk webhook (required IF you point Skywalk at /api/skywalk/webhook)
# HMAC SHA-256 secret. Without this, the webhook route returns 500.
SKYWALK_WEBHOOK_SECRET=

# ----- AppFolio outbound push (required for /api/appfolio/* to function) -----
APPFOLIO_BASE_URL=
APPFOLIO_API_KEY=
APPFOLIO_PUSH_SECRET=

# Optional AppFolio tuning
# APPFOLIO_AUTH_HEADER=Authorization
# APPFOLIO_AUTH_SCHEME=Bearer\ 
# APPFOLIO_TIMEOUT_MS=15000
# APPFOLIO_MAX_RETRIES=4
# APPFOLIO_USER_AGENT=parcel-pilot-appfolio/1.0
# APPFOLIO_NOTE_PATH=/v1/notes
# APPFOLIO_NOTE_BY_ID=/v1/notes/{id}
# APPFOLIO_OWNER_PATH=/v1/owners
# APPFOLIO_OWNER_BY_ID=/v1/owners/{id}

# Set APPFOLIO_DRY_RUN=1 in preview deploys to walk the policy without
# actually calling AppFolio. Useful for staging / smoke tests.
# APPFOLIO_DRY_RUN=

# ----- Vercel cron (required for production cron jobs) -----------------------
# Vercel automatically sends `Authorization: Bearer ${CRON_SECRET}` to every
# cron path when this env var is set. Generate a long random string.
CRON_SECRET=

# ----- Skip-trace providers (optional, used by /api/settings/skip-trace) -----
# BATCHDATA_API_KEY=
